flowchart TD
  Start["Incoming Request"] --> Match{"Route matches\nmethod and path?"}
  Match -- "No" --> NotFound["404 JSON error"]
  Match -- "Yes" --> Options{"OPTIONS preflight?"}
  Options -- "Yes" --> Preflight["204 response"]
  Preflight --> ResponsePolicies
  Options -- "No" --> RequestPolicies["Apply request policies in order"]
  RequestPolicies --> ShortCircuit{"Policy returned\na Response?"}
  ShortCircuit -- "Yes" --> PolicyResponse["Return policy response"]
  ShortCircuit -- "No" --> Origin["Call configured origin"]
  Origin --> ResponsePolicies["Apply response policies in order"]
  PolicyResponse --> Finalize
  ResponsePolicies --> Finalize["Finalize response\nRecord latency"]
  NotFound --> Finalize
  Finalize --> Analytics["Schedule analytics via ctx.waitUntil"]
  Finalize --> Client["Return Response"]

  Origin -. "url" .-> UrlTarget["Forward request\nPreserve query string\nApply path rewrite"]
  Origin -. "proxyAll or upstreamWithFallback" .-> Health["Check cached primary health"]
  Health --> Primary{"Primary healthy?"}
  Primary -- "Yes" --> PrimaryFetch["Fetch primary"]
  Primary -- "No" --> FallbackFetch["Fetch fallback"]
  PrimaryFetch --> ServerError{"5xx or fetch failure?"}
  ServerError -- "Yes" --> FallbackFetch
  ServerError -- "No" --> Rewrite["Rewrite upstream Location header"]
  FallbackFetch --> Rewrite

  classDef terminal fill:#DCFCE7,stroke:#22C55E,color:#111827;
  classDef error fill:#FEE2E2,stroke:#EF4444,color:#111827;
  class Client,Analytics terminal;
  class NotFound error;
