flowchart LR
  Client["API clients"] --> Edge

  subgraph Worker["Cloudflare Worker"]
    Edge["fetch handler\nsrc/index.ts"]
    Config["Route and policy configuration\nsrc/config.json"]
    Compiler["compileGateway\nsrc/gateway/compiler.ts"]
    Runtime["executeGatewayRequest\nsrc/gateway/runtime.ts"]
    RequestPolicies["Request policies\nBasic auth, Auth0 JWT, JSON validation, method change"]
