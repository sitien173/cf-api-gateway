{
  "name": "cf-api-gateway",
  "version": "0.4.8",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.23.12",
    "typescript": "^4.9.4",
    "wrangler": "^4.124.0"
  },
  "scripts": {
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "bundle": "wrangler deploy --dry-run --outdir dist",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "types": "wrangler types",
    "types:check": "wrangler types --check"
  },
  "dependencies": {
    "@cfworker/json-schema": "^1.12.5",
    "jose": "^4.11.1"
  }
}
